# Copy to services/gateway/.env (never commit it). Throwaway TEST wallets only.

# Chain + RPC. Local anvil: CHAIN_ID=31337, RPC_URL=http://127.0.0.1:8545
# Aevum fork: CHAIN_ID=440050, RPC_URL=http://127.0.0.1:8555
# Aevum testnet: CHAIN_ID=44005, RPC_URL=https://rpc-test.qday.info
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Deployed EscrowCourt + parties.
ESCROW_ADDRESS=
SELLER_ADDRESS=
ARBITER_ADDRESS=

# Optional: token override (defaults to the real tUSD8 address; set to the
# MockUSD8 address for plain-anvil local runs).
# TOKEN_ADDRESS=

# Price in token base units (tUSD8 has 6 decimals; 5000000 = 5 tUSD8).
PRICE=5000000
DELIVERY_WINDOW_SECS=3600
REVIEW_WINDOW_SECS=900
PORT=8787

# Keys: RELAYER submits openCaseWithAuthorization (needs native gas).
# SELLER marks delivery (must match SELLER_ADDRESS).
RELAYER_KEY=
SELLER_KEY=

# Copy to services/judge/.env (never commit it). Throwaway TEST wallet only.

# Chain + RPC (same network as the gateway).
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Deployed EscrowCourt + the seller storefront (evidence source).
ESCROW_ADDRESS=
GATEWAY_URL=http://127.0.0.1:8787

# Judge's own controls: poll interval and the largest case it will decide
# alone (base units; 100000000 = 100 tUSD8). Bigger cases are logged and
# left for manual review.
POLL_SECS=15
JUDGE_MAX_CASE=100000000
STATE_FILE=.judge-state.json

# Arbiter key (must be the arbiter named in the cases it resolves; needs gas).
JUDGE_KEY=
